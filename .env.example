# Kopiere diese Datei nach .env und trage deine echten Werte ein.
# Die .env-Datei wird NICHT nach Git gepusht.

# Server
NODE_ENV=production
PORT=3000

# Telegram-Benachrichtigungen (optional)
# Bot-Token vom @BotFather, Chat-ID z.B. via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# InfluxDB (optional)
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=
